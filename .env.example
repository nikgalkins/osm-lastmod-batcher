# Google Sheets
SPREADSHEET_NAME=OSM Routes
SHEET_NAME=relation_ids
RELATION_ID_COL=1
START_ROW=2

# Path to your service account JSON (DO NOT COMMIT IT)
GCP_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json

# Overpass
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=osm-lastmod-batcher/1.0 (contact: team@example.com)
OVERPASS_QUERY_TIMEOUT_S=300

# Cooldowns
COOLDOWN_429_MIN_S=30
COOLDOWN_429_MAX_S=60
COOLDOWN_504_MIN_S=1
COOLDOWN_504_MAX_S=3

# Batch
BATCH_SIZE=20
RECURSION_DEPTH=1
SLEEP_BETWEEN_BATCHES_S=8.0

# Output
OUTPUT_HEADER_RANGE=B1:G1
OUTPUT_START_COL=B
OUTPUT_COLS_COUNT=6
STATUS_COL_INDEX_0BASED=6

OUTPUT_END_COL=G